# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# --- Database (MongoDB Atlas free tier — M0, 512MB, $0/forever) ---
# Get this from Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <password> and add your database name before the "?".
# Example: mongodb+srv://meryfilms_user:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/meryfilms?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/meryfilms?retryWrites=true&w=majority

# --- Auth ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Demo admin account (auto-created on first boot if it doesn't exist yet) ---
ADMIN_EMAIL=admin@meryfilms.rw
ADMIN_PASSWORD=MeryFilms@2026
ADMIN_NAME=MeryFilms Admin

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
# Local dev + your deployed frontend URL (e.g. Vercel/Netlify domain).
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# --- Rate limiting ---
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
